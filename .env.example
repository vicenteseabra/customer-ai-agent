# Store Chat local configuration.
# Copy this file to `.env` and adjust values as needed. No secrets are required:
# everything runs locally against SQLite, a local vector store, and Ollama.

# Path to the SQLite database file used for conversation and business data persistence.
STORE_CHAT_DB_PATH=./data/store_chat.sqlite3

# Directory containing the source CSVs (and policies PDF) to import.
STORE_CHAT_SOURCE_DIR=./data/source

# Directory used for the persistent local vector store (policy index).
STORE_CHAT_VECTOR_PATH=./data/vector_store

# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Local Ollama model used for chat generation.
OLLAMA_CHAT_MODEL=llama3.1

# Local Ollama model used for text embeddings.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
